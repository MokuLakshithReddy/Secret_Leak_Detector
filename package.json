{
  "name": "secret-leak-detector",
  "displayName": "Secret Leak Detector",
  "description": "Developer-first credential protection. Detect, trace, block, and fix secret leaks before they leave your machine.",
  "version": "1.0.4",
  "publisher": "MokuLakshithReddy",
  "icon": "media/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/MokuLakshithReddy/Secret_Leak_Detector.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "secret",
    "security",
    "git",
    "leak",
    "credentials",
    "api-key",
    "pre-commit"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "secret-leak-detector": "./dist/cli.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Secret Leak Detector executes git commands and manages pre-commit hooks, requiring a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Secret Leak Detector requires access to a local filesystem and Git binary."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "secret-leak-detector.scanWorkspace",
        "title": "Scan Workspace for Secrets",
        "category": "Secret Leak Detector",
        "icon": "$(search)"
      },
      {
        "command": "secret-leak-detector.scanStaged",
        "title": "Scan Git Staged Changes",
        "category": "Secret Leak Detector",
        "icon": "$(git-commit)"
      },
      {
        "command": "secret-leak-detector.openDashboard",
        "title": "Open Security Dashboard",
        "category": "Secret Leak Detector",
        "icon": "$(shield)"
      },
      {
        "command": "secret-leak-detector.installGitHook",
        "title": "Install Git Pre-Commit Hook",
        "category": "Secret Leak Detector",
        "icon": "$(check)"
      },
      {
        "command": "secret-leak-detector.uninstallGitHook",
        "title": "Uninstall Git Pre-Commit Hook",
        "category": "Secret Leak Detector",
        "icon": "$(trash)"
      },
      {
        "command": "secret-leak-detector.ignoreFinding",
        "title": "Ignore Finding as False Positive",
        "category": "Secret Leak Detector"
      },
      {
        "command": "secret-leak-detector.unignoreFinding",
        "title": "Restore Suppressed Finding",
        "category": "Secret Leak Detector"
      },
      {
        "command": "secret-leak-detector.clearFindings",
        "title": "Clear All Findings",
        "category": "Secret Leak Detector",
        "icon": "$(clear-all)"
      },
      {
        "command": "secret-leak-detector.installGitHookStrict",
        "title": "Install Git Pre-Commit Hook (Strict / Enterprise Mode)",
        "category": "Secret Leak Detector",
        "icon": "$(shield)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "secret-leak-detector-sidebar",
          "title": "Secret Leak Detector",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "secret-leak-detector-sidebar": [
        {
          "id": "secret-leak-detector.findingsView",
          "name": "Active Leaks & Findings"
        },
        {
          "id": "secret-leak-detector.overviewView",
          "name": "Security Overview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "secret-leak-detector.scanWorkspace",
          "when": "view == secret-leak-detector.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "secret-leak-detector.openDashboard",
          "when": "view == secret-leak-detector.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "secret-leak-detector.clearFindings",
          "when": "view == secret-leak-detector.findingsView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Secret Leak Detector",
      "properties": {
        "secretLeakDetector.enableRealtimeScanning": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan open documents on save or change."
        },
        "secretLeakDetector.blockGitCommits": {
          "type": "boolean",
          "default": true,
          "description": "Intercept commits and block them if unredacted credentials are staged."
        },
        "secretLeakDetector.minEntropy": {
          "type": "number",
          "default": 3.4,
          "description": "Minimum Shannon entropy threshold for generic secret detection."
        },
        "secretLeakDetector.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask credential values in the UI, tree views, tooltips, and terminal to avoid secondary leaks. Disabling this setting displays raw unmasked secrets in tree tooltips and findings views."
        },
        "secretLeakDetector.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "dist/**",
            "build/**",
            "**/package-lock.json",
            "**/pnpm-lock.yaml",
            "**/yarn.lock"
          ],
          "description": "File patterns excluded from workspace secret scans."
        },
        "secretLeakDetector.ignoreSkipped": {
          "type": "boolean",
          "default": false,
          "description": "Treat binary files and oversized files as warnings during Git staged scans instead of blocking commits."
        },
        "secretLeakDetector.strict": {
          "type": "boolean",
          "default": true,
          "description": "Enforce strict enterprise security: block commits on skipped files and disallow inline suppression comments."
        },
        "secretLeakDetector.failOnSkipped": {
          "type": "boolean",
          "default": true,
          "description": "Fail closed and block commits if any files cannot be inspected during staged scans (strict mode default)."
        },
        "secretLeakDetector.disallowInlineIgnore": {
          "type": "boolean",
          "default": true,
          "description": "Disallow inline comments (// sld-ignore) from suppressing secret findings in Git commits and scans (matches CI guardrail)."
        },
        "secretLeakDetector.failOn": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "default": "HIGH",
          "description": "Minimum risk severity that blocks Git commits and triggers blocking gates."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "lint": "tsc --noEmit",
    "cli": "node esbuild.js --cli && node dist/cli.js",
    "test": "node esbuild.js --test && node dist/test-suite.js",
    "benchmark": "node esbuild.js --benchmark && node dist/benchmark.js",
    "benchmark:multi": "node esbuild.js --multi-benchmark && node dist/multi-benchmark.js",
    "benchmark:gate": "node esbuild.js --regression-gate && node dist/regression-gate.js --fast",
    "benchmark:scale": "node esbuild.js --scale-benchmark && node dist/scale-benchmark.js",
    "benchmark:realworld": "node esbuild.js --realworld-benchmark && node dist/realworld-benchmark.js",
    "benchmark:realworld:diagnose": "node esbuild.js --realworld-diagnose && node dist/realworld-diagnose.js",
    "profile": "node esbuild.js --profile && node dist/profile.js",
    "demo": "node esbuild.js --demo && node dist/demo-cli.js",
    "package": "vsce package --no-git-tag-version --no-dependencies",
    "benchmark:heldout": "npx ts-node --project tsconfig.json evaluation/datasets/heldOutCorpus.ts",
    "test:git-hook": "npx ts-node --project tsconfig.json test/integration/gitHookScenarios.test.ts",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "test:vscode": "node esbuild.js --vscode-test && npx ts-node --project tsconfig.json test/vscode-integration/runTest.ts",
    "test:manifest": "npx ts-node --project tsconfig.json test/integration/vscodeExtensionHost.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.1",
    "mocha": "^12.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "bugs": {
    "url": "https://github.com/MokuLakshithReddy/Secret_Leak_Detector/issues"
  },
  "homepage": "https://github.com/MokuLakshithReddy/Secret_Leak_Detector#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
