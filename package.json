{
  "name": "secret-leak-detector",
  "displayName": "Secret Leak Detector",
  "description": "Developer-first credential protection. Detect, trace, block, and fix secret leaks before they leave your machine.",
  "version": "1.0.0",
  "publisher": "MokuLakshithReddy",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MokuLakshithReddy/Secret_Leak_Detector.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "secret",
    "security",
    "git",
    "leak",
    "credentials",
    "api-key",
    "pre-commit"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "secret-leak-detector.scanWorkspace",
        "title": "Secret Leak Detector: Scan Workspace for Secrets",
        "category": "Security",
        "icon": "$(search)"
      },
      {
        "command": "secret-leak-detector.scanStaged",
        "title": "Secret Leak Detector: Scan Git Staged Changes",
        "category": "Security",
        "icon": "$(git-commit)"
      },
      {
        "command": "secret-leak-detector.openDashboard",
        "title": "Secret Leak Detector: Open Security Dashboard",
        "category": "Security",
        "icon": "$(shield)"
      },
      {
        "command": "secret-leak-detector.installGitHook",
        "title": "Secret Leak Detector: Install Git Pre-Commit Hook",
        "category": "Security",
        "icon": "$(check)"
      },
      {
        "command": "secret-leak-detector.clearFindings",
        "title": "Secret Leak Detector: Clear Findings",
        "category": "Security",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "secret-leak-detector-sidebar",
          "title": "Secret Leak Detector",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "secret-leak-detector-sidebar": [
        {
          "id": "secret-leak-detector.findingsView",
          "name": "Active Leaks & Findings"
        },
        {
          "id": "secret-leak-detector.overviewView",
          "name": "Security Overview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "secret-leak-detector.scanWorkspace",
          "when": "view == secret-leak-detector.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "secret-leak-detector.openDashboard",
          "when": "view == secret-leak-detector.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "secret-leak-detector.clearFindings",
          "when": "view == secret-leak-detector.findingsView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Secret Leak Detector",
      "properties": {
        "secretLeakDetector.enableRealtimeScanning": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan open documents on save or change."
        },
        "secretLeakDetector.blockGitCommits": {
          "type": "boolean",
          "default": true,
          "description": "Intercept commits and block them if unredacted credentials are staged."
        },
        "secretLeakDetector.minEntropy": {
          "type": "number",
          "default": 3.4,
          "description": "Minimum Shannon entropy threshold for generic secret detection."
        },
        "secretLeakDetector.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask credential values in the UI and terminal to avoid secondary leaks."
        },
        "secretLeakDetector.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.min.js",
            "**/*.lock",
            "**/package-lock.json",
            "**/pnpm-lock.yaml"
          ],
          "description": "File patterns excluded from workspace secret scans."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm.cmd run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}
